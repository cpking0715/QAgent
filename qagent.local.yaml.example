# QAgent 本地私密配置（含 API Key）
# 用法：复制本文件为 qagent.local.yaml，填入 api_key
# 注意：qagent.local.yaml 已在 .gitignore 中，请勿提交到 Git

llm:
  # OpenAI 或兼容接口的 API Key（必填，才能运行 qagent run）
  api_key: "sk-your-api-key-here"

  # 可选：覆盖 qagent.yaml 中的 LLM 设置
  # model: gpt-4o-mini
  # base_url: https://api.openai.com/v1
  # temperature: 0.2
  # max_tokens: 8192

  # 若使用环境变量而非文件，可删除 api_key 行，改用：
  # api_key_env: OPENAI_API_KEY
